<view class="page"><text class="title">车辆遥控器</text><text>{{status}}</text><view class="password-panel"><text class="password-label">设备配对密码</text><input class="password-input" password="true" value="{{passwordValue}}" maxlength="128" placeholder="请输入设备配对密码" bindinput="onPasswordInput" disabled="{{ok || connecting || disconnecting}}"/><text class="password-hint">{{passwordHint}}</text></view><button class="connect" bindtap="toggleConnection" loading="{{connecting || disconnecting}}" disabled="{{connecting || disconnecting}}">{{disconnecting ? "断开中…" : connecting ? "连接中…" : ok ? "断开连接" : "连接 ESP32"}}</button><button class="unlock" bindtap="unlock" disabled="{{!ok || disconnecting}}">解锁</button><button class="lock" bindtap="lock" disabled="{{!ok || disconnecting}}">锁车</button><button class="start" bindtap="start" disabled="{{!ok || disconnecting}}">启动 ⚡</button><button class="find" bindtap="findCar" disabled="{{!ok || disconnecting}}">寻车 🔊</button><view class="logs-panel"><view class="logs-toolbar"><text bindtap="toggleLogs">ESP32 日志 {{logsOpen ? '▾' : '▸'}}</text><button size="mini" bindtap="clearLogs">清空</button></view><view wx:if="{{logsOpen}}"><text class="logs-hint">{{logHint}}</text><scroll-view class="logs-scroll" scroll-y="true" scroll-into-view="{{logBottom}}"><text wx:if="{{!logs.length}}" class="log-line">暂无日志，验证后等待接收</text><text wx:for="{{logs}}" wx:key="id" id="{{item.id}}" class="log-line" selectable="true">{{item.text}}</text></scroll-view></view></view><text class="hint">请确认周边安全后操作</text></view>
